# Copy this file to .env and fill in your values

# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ehr_db

# HuggingFace model identifier (domain-specific BERT)
CLINICALBERT_MODEL=medicalai/ClinicalBERT

# Directories (relative to project root)
ARTIFACTS_DIR=artifacts
LOG_DIR=logs

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Transformer tokeniser max token length
MAX_TOKEN_LENGTH=512

# Class weight for the "Distress" label (penalises false negatives)
DISTRESS_CLASS_WEIGHT=3.0

# Number of top attention tokens returned per prediction
ATTENTION_TOP_K=10
