# ──────────────────────────────────────────────
# Python / Backend
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg

# Environment variables
.env
.env.*
!.env.example

# ──────────────────────────────────────────────
# ML / Model Artifacts
# ──────────────────────────────────────────────
# Keep the pre-trained classifier but ignore large generated caches
artifacts/embedding_cache.npz
artifacts/ablation_report.txt
artifacts/*.png

# Uncomment to also ignore the trained classifier:
# artifacts/classifier.joblib

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
*.sqlite3
*.db

# ──────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────
logs/
*.log

# ──────────────────────────────────────────────
# Testing / Coverage
# ──────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.coveragerc

# ──────────────────────────────────────────────
# Type checking / linting
# ──────────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ──────────────────────────────────────────────
# IDEs & editors
# ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ──────────────────────────────────────────────
# OS
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db

# ──────────────────────────────────────────────
# Frontend (node / Vite) — scoped to frontend/
# ──────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env
frontend/.env.*
!frontend/.env.example
